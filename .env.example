# ============================================================
# TEMPLATE DES VARIABLES D'ENVIRONNEMENT — Kessabcom v31
# ============================================================
# Copiez ce fichier vers .env et remplissez les valeurs réelles.
#
#   cp .env.example .env
#
# ⚠️  Ne commitez JAMAIS le fichier .env sur Git.
# ============================================================

# ── Serveur Express ──────────────────────────────────────────
PORT=3000

# ── Firebase Client (Frontend) — préfixe VITE_ obligatoire ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_DATABASE_ID=(default)

# ── reCAPTCHA Enterprise (public) ────────────────────────────
VITE_RECAPTCHA_SITE_KEY=

# ── Google Maps + Cloud API (server-side reCAPTCHA) ──────────
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_CLOUD_API_KEY=

# ── Firebase Admin SDK ────────────────────────────────────────
# Option A (Local dev) : fichier JSON sur disque
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Option B (Production / Docker) : JSON complet en 1 ligne
#   cat firebase-service-account.json | jq -c . | pbcopy
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# Option C : variables individuelles (moins recommandé)
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# ── CashPlus Marchand API — Paiements en agences ─────────────
# Obtenez ces valeurs après signature du contrat marchand CashPlus.
# URL de callback à déclarer à CashPlus :
#   https://kessabcom.ma/api/payments/cashplus/callback
CASHPLUS_BASE_URL=https://cpay.ma/cpws/cpmarchand/index.cfm
CASHPLUS_MARCHAND_CODE=
CASHPLUS_SECRET_KEY=

# ── SMTP — Emails de notifications ───────────────────────────
# Pour Gmail : activer "Mot de passe des applications" dans
# Paramètres Google → Sécurité → Mots de passe des applications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=kessabcom.maroc@gmail.com
SMTP_PASS=
