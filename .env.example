# ============================================================
# .env.example — Template for all required environment variables
# ============================================================
# Copy this file to .env and fill in real values for local dev.
# For production (Vercel), add each variable in the dashboard.

# ============================================================
# Firebase Client (Frontend) — all exposed to the browser via Vite
# ============================================================
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abc123
VITE_FIRESTORE_DATABASE_ID=(default)

# reCAPTCHA Enterprise site key (public — safe to expose)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_enterprise_site_key

# ============================================================
# Backend (Express API) — NOT exposed to the browser
# ============================================================

# Server port
PORT=3000

# Google Cloud API key for server-side reCAPTCHA assessments + Maps
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key

# ---- Firebase Admin SDK: choose ONE option ----

# Option A (Local dev): path to service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Option B (Production / Vercel): full service account JSON as one line
# Generate: cat firebase-service-account.json | python3 -c "import sys,json; print(json.dumps(json.load(sys.stdin)))"
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"..."}

# Option C (individual vars — fallback if B is too long)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# ============================================================
# Optional integrations
# ============================================================
# VITE_GOOGLE_MAPS_API_KEY=your_maps_api_key
# RESEND_API_KEY=re_xxxxxxxxxxxx
