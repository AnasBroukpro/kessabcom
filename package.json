{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:api": "npx tsx server.ts",
    "dev:client": "npx vite",
    "dev": "node -e \"const {spawn}=require('child_process');const a=spawn('npx',['tsx','server.ts'],{stdio:'inherit',shell:true});const b=spawn('npx',['vite'],{stdio:'inherit',shell:true});[a,b].forEach(p=>p.on('exit',()=>{process.exit()}))\"",
    "start": "npx tsx server.ts",
    "build": "npx vite build",
    "preview": "npx vite preview",
    "clean": "rm -rf dist",
    "lint": "npx tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.10.0",
    "@react-google-maps/api": "^2.20.8",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^5.0.6",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "firebase": "^12.12.0",
    "firebase-admin": "^13.8.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-firebase-hooks": "^5.1.1",
    "react-router-dom": "^7.14.1",
    "recharts": "^3.8.1",
    "resend": "^6.12.0",
    "tsx": "^4.21.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/google.maps": "^3.58.1",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
